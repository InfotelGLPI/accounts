{# Password history: keys and plaintext have no name and are never posted. #}
{% if not item.isNewItem() %}
    <details class="accounts-password-history"
             data-account-id="{{ item.getID() }}"
             data-wrong-key="{{ __('Wrong encryption key', 'accounts') }}"
             data-decryption-failed="{{ __('Unable to decrypt this password history entry.', 'accounts') }}">
        <summary class="history-panel-summary">
            <i class="ti ti-history" aria-hidden="true"></i>
            <span>{{ __('Password history', 'accounts') }}</span>
            <span class="badge bg-blue-lt">{{ password_history|length }}</span>
            <i class="ti ti-chevron-down history-panel-chevron" aria-hidden="true"></i>
        </summary>
        <div class="history-panel-body">
            <div class="history-panel-toolbar">
                <strong class="small">{{ __('Password history', 'accounts') }}</strong>
                <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary history-close"
                        aria-label="{{ __('Close') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            {% if password_history is empty %}
                <p class="small text-muted my-2">{{ __('No previous passwords.', 'accounts') }}</p>
            {% else %}
                {% for entry in password_history %}
                    <details class="accounts-password-history-entry"
                             data-history-id="{{ entry.id }}"
                             data-ciphertext="{{ entry.encrypted_password }}"
                             data-verifier="{{ entry.hash }}" {% if loop.first %}open{% endif %}>
                        <summary class="history-entry-summary">
                            <i class="ti ti-lock" aria-hidden="true"></i>
                            <span class="history-entry-metadata">
                                <span>{{ entry.date_change|formatted_datetime }}</span>
                                <span class="small text-muted">
                                    {{ call('getUserName', [entry.users_id]) }}
                                    · {{ entry.hash_name }} (#{{ entry.plugin_accounts_hashes_id }})
                                </span>
                            </span>
                            <i class="ti ti-chevron-down history-entry-chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="history-entry-body">
                            <div class="input-group input-group-sm">
                                <input type="password" class="form-control history-key" autocomplete="off"
                                       placeholder="{{ __('Encryption key', 'accounts') }}"
                                       aria-label="{{ __('Encryption key', 'accounts') }}">
                                <button type="button" class="btn btn-outline-secondary" data-history-action="decrypt">
                                    <i class="ti ti-lock-open me-1" aria-hidden="true"></i>
                                    {{ __('Decrypt', 'accounts') }}
                                </button>
                            </div>
                            <div class="input-group input-group-sm mt-2">
                                <input type="password" id="history_password_{{ entry.id }}" readonly
                                       class="form-control history-password" autocomplete="off"
                                       aria-label="{{ __('Previous password', 'accounts') }}">
                                <button type="button" class="btn btn-outline-secondary" data-history-action="reveal" disabled
                                        aria-label="{{ __('Show password', 'accounts') }}">
                                    <i class="ti ti-eye" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-history-action="copy" disabled
                                        aria-label="{{ __('Copy password', 'accounts') }}">
                                    <i class="ti ti-clipboard-copy" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span class="history-error small text-danger" role="status" aria-live="polite"></span>
                        </div>
                    </details>
                {% endfor %}
            {% endif %}
        </div>
    </details>
{% endif %}
