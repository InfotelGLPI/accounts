{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{# Only the fingerprint travels: the export is gated on the verification marker kept in the session. #}
{% if show_export %}
    <form method="post" action="{{ export_url }}" target="_blank" class="d-flex align-items-center gap-2 mb-3">
        {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
        {{ inputs.hidden('itemtype', 'GlpiPlugin\\Accounts\\Report') }}
        {{ inputs.hidden('id', hash_id) }}
        <div class="col-auto">
            {% do call('Dropdown::showFromArray', ['display_type', export_formats]) %}
        </div>
        <div class="col-auto">
            {{ inputs.submit('export', _x('button', 'Export'), 1, {class: 'btn btn-primary'}) }}
        </div>
    </form>
{% endif %}

{# The key is read once by public/scripts/report.js, which decrypts every cell then drops the attribute. #}
<div data-accounts-report
     data-accounts-verifier="{{ verifier }}"
     data-accounts-aeskey="{{ aeskey }}"
     data-accounts-wrong-key="{{ __('Wrong encryption key', 'accounts') }}">
    {{ include('components/datatable.html.twig', datatable_params, with_context = false) }}
</div>
